# Emma Basic CMS — environment configuration
# Copy to `.env` for local use, or set these as Environment Variables in Vercel.

# --- Backend selection -------------------------------------------------------
# "local"  = read/write files on disk, publish with the Publish button (default)
# "github" = read/write via the GitHub API; every save auto-commits + deploys
CMS_BACKEND=github

# --- Authentication (required online) ---------------------------------------
# The password you type to sign in.
CMS_PASSWORD=change-me-to-a-long-random-string
# Secret used to sign the session cookie. MUST be set (and kept stable) online,
# otherwise logins won't persist across serverless instances. Use a long random
# value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
CMS_SECRET=replace-with-a-64-char-random-hex-string

# --- GitHub backend settings (only used when CMS_BACKEND=github) -------------
# A token with read/write access to the repository's Contents.
#  - Fine-grained PAT: Repository access = this repo; Permissions -> Contents: Read and write.
#  - Or a classic PAT with the `repo` scope.
GITHUB_TOKEN=github_pat_xxx
# owner/name of the repository that holds the site + data files.
GITHUB_REPO=Thebasicingredientsltd/EMMABASIC-MAIN
# Branch the live site deploys from (commits here trigger the site's deploy).
GITHUB_BRANCH=main

# Optional: how commits made by the CMS are attributed.
# CMS_COMMIT_NAME=Emma Basic CMS
# CMS_COMMIT_EMAIL=cms@emmabasic.local
