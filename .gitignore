# The CMS Publish button runs "git add -A", so anything sitting in this folder
# gets committed and deployed. Keep local-only files out of that sweep.

# Python virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Windows / macOS folder metadata
desktop.ini
Thumbs.db
.DS_Store

# Editor scratch files
*.swp
*~
