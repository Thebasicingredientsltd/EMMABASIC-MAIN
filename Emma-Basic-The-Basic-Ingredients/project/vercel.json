{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/Become a Distributor.html",
      "destination": "/Places.html?section=how-to-order",
      "permanent": true
    },
    {
      "source": "/Become%20a%20Distributor.html",
      "destination": "/Places.html?section=how-to-order",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
